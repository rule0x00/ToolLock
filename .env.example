# Copy to .env and fill in. Never commit .env.

# --- Postgres (docker compose) ---
POSTGRES_USER=toollock
POSTGRES_PASSWORD=toollock
POSTGRES_DB=toollock
POSTGRES_PORT=5432

# --- Gateway ---
# Host-side URL, for running `npm run dev` / `npm run migrate` / tests outside Docker.
# (In docker compose the gateway uses the postgres service hostname instead.)
DATABASE_URL=postgres://toollock:toollock@localhost:5432/toollock
GATEWAY_PORT=3000
# Bearer token MCP clients send to /mcp (Authorization: Bearer <token>).
MCP_CLIENT_TOKEN=change-me-mcp
# Bearer token for the admin API and dashboard (MVP auth).
ADMIN_TOKEN=change-me-admin
REVIEWER_URL=http://localhost:8000
TOOLLOCK_CONFIG=toollock.config.json

# --- Reviewer (set one LLM provider) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model override, e.g. claude-sonnet-5-5
REVIEWER_MODEL=
REVIEWER_PORT=8000

# --- Dashboard ---
DASHBOARD_PORT=3001
