# Copy to .env and change the tokens. Never commit .env.

# --- Postgres (docker compose) ---
POSTGRES_USER=toollock
POSTGRES_PASSWORD=toollock
POSTGRES_DB=toollock
POSTGRES_PORT=5432

# --- Gateway ---
# Host-side URL, for `npm run dev` / `npm run migrate` / `npm test` outside Docker.
# (In docker compose the gateway uses the postgres service hostname instead.)
DATABASE_URL=postgres://toollock:toollock@localhost:5432/toollock
GATEWAY_PORT=3000
# Bearer token MCP clients send to /mcp (Authorization: Bearer <token>). Required.
MCP_CLIENT_TOKEN=change-me-mcp
# Bearer token for the admin API; the dashboard uses it server-side. Required.
ADMIN_TOKEN=change-me-admin
REVIEWER_URL=http://localhost:8000
TOOLLOCK_CONFIG=toollock.config.json
# Where `init` writes mcp.lock.json (relative to gateway/). Docker uses gateway/lock/mcp.lock.json.
LOCKFILE_PATH=mcp.lock.json

# --- Reviewer (set one LLM provider, or none for deterministic rules only) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model override. Defaults: claude-sonnet-5-5 (Anthropic), gpt-4.1 (OpenAI).
REVIEWER_MODEL=
REVIEWER_PORT=8000

# --- Dashboard ---
DASHBOARD_PORT=3001
